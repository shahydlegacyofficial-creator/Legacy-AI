{
  "name": "legacy",
  "version": "3.24.0",
  "description": "Legacy AI desktop assistant",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "desktop": "node src/desktop.js",
    "configure": "node src/desktop.js configure",
